<%- include('partials/adminHeader') %>

  <div class="admin-page-header">
    <h1>Categories</h1>
    <a href="/admin" class="btn btn-secondary">&larr; Back to Dashboard</a>
  </div>

  <% if (error) { %>
    <p class="form-error"><%= error %></p>
  <% } %>
  <% if (success) { %>
    <p class="form-success"><%= success %></p>
  <% } %>

  <div class="admin-card" style="margin-bottom: 24px;">
    <form method="POST" action="/admin/categories" class="admin-form">
      <label>New Category
        <input type="text" name="name" placeholder="e.g. Solo Travel" required />
      </label>
      <button type="submit" class="btn">+ Add Category</button>
    </form>
  </div>

  <div class="admin-card">
    <table class="admin-table">
      <thead>
        <tr><th>Name</th><th>Post Count</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% categoryCounts.forEach(function(cat) { %>
          <tr>
            <td>
              <form method="POST" action="/admin/categories/rename" class="inline-form">
                <input type="hidden" name="oldName" value="<%= cat.name %>" />
                <input type="text" name="newName" value="<%= cat.name %>" style="padding:6px 8px; border:1px solid var(--color-border); border-radius:6px; background:var(--color-bg-alt); color:var(--color-text);" />
                <button type="submit" class="btn btn-secondary" style="padding:6px 12px;">Save</button>
              </form>
            </td>
            <td><%= cat.count %></td>
            <td class="admin-row-actions">
              <form method="POST" action="/admin/categories/delete" class="inline-form" onsubmit="return confirm('Delete category &quot;<%= cat.name %>&quot;?');">
                <input type="hidden" name="name" value="<%= cat.name %>" />
                <button type="submit" class="link-btn">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (categoryCounts.length === 0) { %>
          <tr><td colspan="3">No categories yet — add one above.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

<%- include('partials/adminFooter') %>
