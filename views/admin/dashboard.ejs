<%- include('partials/adminHeader') %>

  <div class="admin-page-header">
    <h1>Dashboard</h1>
    <a href="/admin/posts/new" class="btn">+ New Post</a>
  </div>

  <div class="admin-stats-row">
    <div class="admin-stat-card">
      <span class="admin-stat-number"><%= posts.length %></span>
      <span class="admin-stat-label">Total Posts</span>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-number"><%= posts.filter(function(p){ return p.published; }).length %></span>
      <span class="admin-stat-label">Published</span>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-number"><%= posts.filter(function(p){ return !p.published; }).length %></span>
      <span class="admin-stat-label">Drafts</span>
    </div>
  </div>

  <div class="admin-card">
    <table class="admin-table">
      <thead>
        <tr><th>Post</th><th>Category</th><th>Date</th><th>Status</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% posts.forEach(function(post) { %>
          <tr>
            <td class="admin-table-title-cell">
              <div class="admin-table-thumb" style="background-image:url('<%= getHeroImage(post) %>')"></div>
              <span><%= post.title %></span>
              <% if (post.featured) { %><span class="status-badge status-badge--featured">&#9733; Top News</span><% } %>
            </td>
            <td><%= post.category %></td>
            <td><%= post.date %></td>
            <td>
              <span class="status-badge <%= post.published ? 'status-badge--live' : 'status-badge--draft' %>">
                <%= post.published ? 'Published' : 'Draft' %>
              </span>
            </td>
            <td class="admin-row-actions">
              <a href="/admin/posts/<%= post.id %>/edit">Edit</a>
              <form method="POST" action="/admin/posts/<%= post.id %>/delete" class="inline-form" onsubmit="return confirm('Delete this post?');">
                <button type="submit" class="link-btn">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (posts.length === 0) { %>
          <tr><td colspan="5">No posts yet — create your first one.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

<%- include('partials/adminFooter') %>
