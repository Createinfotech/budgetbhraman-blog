<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | BudgetBhraman</title>
  <meta name="description" content="Budget travel guides, itineraries and tips for exploring India without overspending." />
  <link rel="stylesheet" href="/css/style.css" />
  <script>
    (function () {
      var saved = localStorage.getItem('bb-theme');
      if (saved === 'dark') document.documentElement.classList.add('dark-mode');
    })();
  </script>
</head>
<body>
  <nav class="navbar">
    <div class="container navbar-inner">
      <a href="/" class="brand">
        <span class="brand-mark">🧭</span>
        <span class="brand-text">Budget<span class="brand-accent">Bhraman</span></span>
      </a>
      <button type="button" id="nav-toggle" class="nav-toggle-btn" aria-label="Toggle menu" aria-expanded="false">&#9776;</button>
      <div class="nav-links" id="nav-links">
        <a href="/" class="nav-home-link <%= currentPath === '/' ? 'active' : '' %>">🏠 Home</a>
        <a href="/?category=Budget+Destinations">Destinations</a>
        <a href="/?category=Itineraries">Itineraries</a>
        <a href="/?category=Travel+Tips">Travel Tips</a>
        <a href="/?category=Packing+Guides">Packing Guides <span class="badge badge-new">New</span></a>
        <a href="/?category=Local+Food+%26+Culture">Food &amp; Culture <span class="badge badge-hot">Hot</span></a>
        <a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">About</a>
        <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
      </div>
      <div class="nav-actions">
        <button type="button" id="search-toggle" class="icon-btn" aria-label="Toggle search" aria-expanded="false" title="Search">🔍</button>
      </div>
    </div>
    <div class="search-drawer" id="search-drawer">
      <form class="container search-drawer-form" action="/" method="get">
        <input type="text" name="q" class="search-input search-drawer-input" placeholder="Search posts..." autocomplete="off" />
        <button type="submit" class="icon-btn" aria-label="Search" title="Search">🔍</button>
      </form>
    </div>
  </nav>

  <main>
